# Arvore de build. Contem as dependencias baixadas pelo FetchContent
# (raylib, raylib-cpp, raygui) alem dos objetos - centenas de MB que o
# CMake regenera do zero.
build/
build-*/
cmake-build-*/

# Diretorio criado por engano por `cmake -B build -BUILD_RAYLIB_CPP_MODULES=ON`:
# faltando o -D, o CMake leu a flag como um segundo -B e criou uma arvore de
# build com este nome literal.
UILD_RAYLIB_CPP_MODULES=ON/

# Dependencias eram submodulo antes de migrarem para FetchContent.
third_party/

# Configuracao de terreno salva pelo painel do HUD. E estado local de
# experimentacao; os valores que valem viram padrao em TerrainGenerator.hpp.
terrain.cfg

# Pasta montada por `cmake --build build --target dist`: uma copia do executavel
# e dos assets, pronta para zipar. Deriva inteiramente do build.
dist/

# Capturas de tela
*.png

# ...menos a arte, que e do jogo e nao do experimento.
#
# A regra acima existe para os screenshot*.png que se acumulam na raiz, e ela pegava
# junto tudo que entrasse em assets/. O sintoma disso nao aparece aqui: o jogo roda
# nesta maquina porque os arquivos estao no disco, e nao roda em nenhum clone, com um
# javali desenhado pelo desenho de reserva e nada dizendo por que.
!assets/**/*.png

.DS_Store
compile_commands.json
